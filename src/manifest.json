{
  "name": "数独",
  "appid": "__UNI__A1B2C3D",
  "description": "离线优先的经典数独游戏",
  "versionName": "1.0.0",
  "versionCode": "10000",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "screenOrientation": [
      "portrait-primary"
    ],
    "statusbar": {
