    },
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "distribute": {
      "android": {
        "minSdkVersion": 23,
        "targetSdkVersion": 35,
        "permissions": [
          "<uses-permission android:name=\"android.permission.VIBRATE\"/>"
        ]
      }
    }
  },
  "h5": {
    "title": "数独",
    "router": {
      "mode": "hash"
    }
  }
}
