{
  "name": "sudoku-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first Sudoku app built with uni-app + Vue 3 + TypeScript + Pinia",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run puzzle:validate",
    "puzzle:validate": "node tools/validate-puzzles.mjs",
    "puzzle:generate": "node tools/generate-puzzles.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "pinia": "^2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "^20.14.12",
    "@vue/runtime-core": "^3.4.21",
    "rollup": "4.14.3",
    "sass": "^1.77.8",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.29"
  }
}
